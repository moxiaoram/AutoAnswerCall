<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>接听模式</string>
			<key>footerText</key>
			<string>方案2需先关闭 iOS 自动接听；白名单是排除名单。号码不可得且名单非空时拒绝接听。公开 CXCall 不提供电话号码。方案1仅引导手动启用系统功能，不发送插件事务。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>defaults</key>
			<string>com.autoanswer.call</string>
			<key>key</key>
			<string>Mode</string>
			<key>default</key>
			<integer>2</integer>
			<key>validValues</key>
			<array>
				<integer>1</integer>
				<integer>2</integer>
			</array>
			<key>label</key>
			<string>接听模式</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>validTitles</key>
			<array>
				<string>方案1：系统备选（全来电）</string>
				<string>方案2：插件排除白名单（默认）</string>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.autoanswer.call</string>
			<key>key</key>
			<string>Enabled</string>
			<key>default</key>
			<true/>
			<key>label</key>
			<string>启用插件策略</string>
			<key>subtitle</key>
			<string>两种模式均读取；不控制 iOS 独立总开关</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>defaults</key>
			<string>com.autoanswer.call</string>
			<key>key</key>
			<string>Delay</string>
			<key>default</key>
			<real>0.5</real>
			<key>min</key>
			<real>0.0</real>
			<key>max</key>
			<real>60.0</real>
			<key>label</key>
			<string>接听等待时间（0～60秒）</string>
			<key>showValue</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>defaults</key>
			<string>com.autoanswer.call</string>
			<key>key</key>
			<string>Whitelist</string>
			<key>label</key>
			<string>不自动接听白名单</string>
			<key>placeholder</key>
			<string>完整号码，逗号分隔；不支持片段或通配符</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>接听后音频</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.autoanswer.call</string>
			<key>key</key>
			<string>PlayAudio</string>
			<key>default</key>
			<false/>
			<key>label</key>
			<string>请求关联连接后本地播放（非上行）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>导入音频文件</string>
			<key>action</key>
			<string>pickAudio:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>试听已导入音频</string>
			<key>action</key>
			<string>testAudio:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>清除已导入音频</string>
			<key>action</key>
			<string>clearAudio:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>打开系统自动接听设置</string>
			<key>action</key>
			<string>openSystemAutoAnswer:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>设置模块日志与音频信息</string>
			<key>action</key>
			<string>showLog:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>电话模块诊断（可能不可见）</string>
			<key>action</key>
			<string>showCallRecords:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>清除设置模块日志</string>
			<key>action</key>
			<string>clearLog:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>探测电话模块（Darwin ping）</string>
			<key>action</key>
			<string>pingPhone:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>导出持久配置（plist）</string>
			<key>action</key>
			<string>exportConfig:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>1.8.0：音频最大5MB，复制至设置沙盒；本地试听不代表电话进程能读取，也不会注入通话上行。MobilePhone 可能被挂起，未保证锁屏后台接听或蜂窝事务权限。</string>
		</dict>
	</array>
</dict>
</plist>
